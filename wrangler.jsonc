{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "proqtrack",
  "main": "worker/main.js",
  "compatibility_date": "2026-07-28",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "proqtrack-mvp"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "proqtrack-mvp-files"
    }
  ],
  "vars": {
    "ENVIRONMENT": "mvp",
    "CORE_DATA_API_ENABLED": "true",
    "CORE_EVIDENCE_API_ENABLED": "true",
    "MVP_DATA_API_ENABLED": "false",
    "MVP_FILE_API_ENABLED": "false",
    "API_AUTH_REQUIRED": "true",
    "API_SESSION_TTL_SECONDS": "28800",
    "API_RATE_LIMIT_PER_MINUTE": "120",
    "API_LOGIN_RATE_LIMIT_PER_MINUTE": "10",
    "API_SYNC_RATE_LIMIT_PER_MINUTE": "60",
    "API_EVIDENCE_RATE_LIMIT_PER_MINUTE": "30",
    "OBSERVABILITY_RETENTION_DAYS": "14",
    "MAINTENANCE_RETENTION_DAYS": "30",
    "EVIDENCE_MAX_FILE_BYTES": "5242880",
    "EVIDENCE_UPLOAD_TYPES": "image/jpeg,image/png,image/webp",
    "MVP_MAX_FILE_BYTES": "2097152",
    "MVP_MAX_STORAGE_BYTES": "524288000",
    "ALLOWED_UPLOAD_TYPES": "application/pdf,text/csv,application/zip,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.openxmlformats-officedocument.wordprocessingml.document,image/jpeg,image/png,image/webp"
  },
  "env": {
    "development": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "proqtrack-development"
        }
      ],
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "proqtrack-development-files"
        }
      ],
      "vars": {
        "ENVIRONMENT": "development",
        "CORE_DATA_API_ENABLED": "true",
        "CORE_EVIDENCE_API_ENABLED": "true",
        "MVP_DATA_API_ENABLED": "false",
        "MVP_FILE_API_ENABLED": "false",
        "API_AUTH_REQUIRED": "true",
        "API_SESSION_TTL_SECONDS": "28800",
        "API_RATE_LIMIT_PER_MINUTE": "120",
        "API_LOGIN_RATE_LIMIT_PER_MINUTE": "10",
        "API_SYNC_RATE_LIMIT_PER_MINUTE": "60",
        "API_EVIDENCE_RATE_LIMIT_PER_MINUTE": "30",
        "OBSERVABILITY_RETENTION_DAYS": "14",
        "MAINTENANCE_RETENTION_DAYS": "30",
        "EVIDENCE_MAX_FILE_BYTES": "5242880",
        "EVIDENCE_UPLOAD_TYPES": "image/jpeg,image/png,image/webp",
        "MVP_MAX_FILE_BYTES": "2097152",
        "MVP_MAX_STORAGE_BYTES": "524288000",
        "ALLOWED_UPLOAD_TYPES": "application/pdf,text/csv,application/zip,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.openxmlformats-officedocument.wordprocessingml.document,image/jpeg,image/png,image/webp"
      }
    },
    "staging": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "proqtrack-staging"
        }
      ],
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "proqtrack-staging-files"
        }
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        "CORE_DATA_API_ENABLED": "true",
        "CORE_EVIDENCE_API_ENABLED": "true",
        "MVP_DATA_API_ENABLED": "false",
        "MVP_FILE_API_ENABLED": "false",
        "API_AUTH_REQUIRED": "true",
        "API_SESSION_TTL_SECONDS": "28800",
        "API_RATE_LIMIT_PER_MINUTE": "120",
        "API_LOGIN_RATE_LIMIT_PER_MINUTE": "10",
        "API_SYNC_RATE_LIMIT_PER_MINUTE": "60",
        "API_EVIDENCE_RATE_LIMIT_PER_MINUTE": "30",
        "OBSERVABILITY_RETENTION_DAYS": "14",
        "MAINTENANCE_RETENTION_DAYS": "30",
        "EVIDENCE_MAX_FILE_BYTES": "5242880",
        "EVIDENCE_UPLOAD_TYPES": "image/jpeg,image/png,image/webp",
        "MVP_MAX_FILE_BYTES": "2097152",
        "MVP_MAX_STORAGE_BYTES": "524288000",
        "ALLOWED_UPLOAD_TYPES": "application/pdf,text/csv,application/zip,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.openxmlformats-officedocument.wordprocessingml.document,image/jpeg,image/png,image/webp"
      }
    },
    "production": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "proqtrack-production"
        }
      ],
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "proqtrack-production-files"
        }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "CORE_DATA_API_ENABLED": "true",
        "CORE_EVIDENCE_API_ENABLED": "true",
        "MVP_DATA_API_ENABLED": "false",
        "MVP_FILE_API_ENABLED": "false",
        "API_AUTH_REQUIRED": "true",
        "API_SESSION_TTL_SECONDS": "28800",
        "API_RATE_LIMIT_PER_MINUTE": "120",
        "API_LOGIN_RATE_LIMIT_PER_MINUTE": "10",
        "API_SYNC_RATE_LIMIT_PER_MINUTE": "60",
        "API_EVIDENCE_RATE_LIMIT_PER_MINUTE": "30",
        "OBSERVABILITY_RETENTION_DAYS": "14",
        "MAINTENANCE_RETENTION_DAYS": "30",
        "EVIDENCE_MAX_FILE_BYTES": "5242880",
        "EVIDENCE_UPLOAD_TYPES": "image/jpeg,image/png,image/webp",
        "MVP_MAX_FILE_BYTES": "2097152",
        "MVP_MAX_STORAGE_BYTES": "524288000",
        "ALLOWED_UPLOAD_TYPES": "application/pdf,text/csv,application/zip,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.openxmlformats-officedocument.wordprocessingml.document,image/jpeg,image/png,image/webp"
      }
    }
  }
}
