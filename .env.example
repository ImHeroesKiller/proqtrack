# Worker auth — set this as a Cloudflare secret, never commit the real value:
#   npx wrangler secret put API_AUTH_SECRET
# Generate at least 32 random bytes, e.g.:
#   openssl rand -base64 48
API_AUTH_SECRET=

# Optional local overrides. File and data APIs stay locked until you
# explicitly enable them after auth_users exist in D1.
# MVP_FILE_API_ENABLED=false
# MVP_DATA_API_ENABLED=false
